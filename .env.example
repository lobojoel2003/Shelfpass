# Copy to .env and adjust. Every setting is optional except the secret key.

# Required in production. Generate with:
#   python -c 'import secrets; print(secrets.token_urlsafe(50))'
SHELFPASS_SECRET_KEY=

# Comma-separated host names this site is served on.
SHELFPASS_ALLOWED_HOSTS=localhost,127.0.0.1
# Full origins (scheme + host) allowed to POST forms when behind HTTPS.
SHELFPASS_CSRF_TRUSTED_ORIGINS=

# postgres://user:password@host:5432/dbname  (defaults to a local SQLite file)
DATABASE_URL=

# Security (on by default when DEBUG is off). Set SHELFPASS_HTTPS=0 for plain-HTTP local testing.
SHELFPASS_HTTPS=1
SHELFPASS_SSL_REDIRECT=0
SHELFPASS_HSTS_SECONDS=0
SHELFPASS_HSTS_PRELOAD=0
SHELFPASS_BEHIND_PROXY=0

# Development only.
SHELFPASS_DEBUG=0

# Facility pages and anonymised rejection data readable without logging in.
SHELFPASS_PUBLIC_DATA=1
# Where volunteers send dataset corrections.
SHELFPASS_DATASET_REPO_URL=https://github.com/lobojoel2003/Shelfpass
# Folder holding the facility-rules dataset (the container image bundles it).
SHELFPASS_DATASET_DIR=

# Open Library book lookup.
SHELFPASS_OPENLIBRARY_ENABLED=1
SHELFPASS_OPENLIBRARY_TIMEOUT=6

SHELFPASS_TIME_ZONE=America/New_York
SHELFPASS_REJECTION_WINDOW_DAYS=365
SHELFPASS_LOG_LEVEL=INFO

# Container start-up behaviour.
SHELFPASS_MIGRATE=1
SHELFPASS_SYNC_DATASET=1
SHELFPASS_DEMO=0
WEB_CONCURRENCY=3
